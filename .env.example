# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=paijo_knowledge

# Embedding provider: "local" (sentence-transformers) or "openai"
EMBEDDING_PROVIDER=local

# Local embedding model (used when EMBEDDING_PROVIDER=local)
LOCAL_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# OpenAI API key (used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# Retrieval settings
TOP_K=3
SCORE_THRESHOLD=0.2

# Knowledge base directory
KNOWLEDGE_DIR=rag-knowledge

# Chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Server
HOST=0.0.0.0
PORT=8100
